# Contact form / quote builder email (spec §5). Copy to .env.local and fill in.

# Required for /api/contact to send anything — without it the route answers
# 503 and both forms fall back to showing the direct email address.
RESEND_API_KEY=

# Where notifications land. Defaults to matthew@mvella.com.
CONTACT_TO_EMAIL=

# Verified sender on mvella.com. Defaults to "MVella Studios <hello@mvella.com>".
# Must be a domain verified in Resend — gmail.com (and any other domain you
# don't own) is rejected as a From address.
CONTACT_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=

# Google Ads conversion label (the part AFTER the slash in send_to).
# From Google Ads → Goals → Conversions → your action → Tag setup.
# Example send_to "AW-18376948373/AbCdEfGhIjKlMnOp" → set AbCdEfGhIjKlMnOp.
# Without this, the base gtag still loads but conversion events are skipped.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Supabase — /agreement signing flow (project: mvella-studios / cwqbjbpjtdhhmfofsgvo).
# SECRET key, server-only: the agreements table has RLS on with no policies,
# so the API route is the only thing that can write (or read) it. Never
# expose this key client-side. Without both vars the route answers 503 and
# the signing form errors — it never fakes a recorded consent.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe — deposit invoicing when an agreement is signed via a quote link.
# STRIPE_SECRET_KEY is the LIVE key: used only on the production deployment.
# STRIPE_TEST_SECRET_KEY is used on previews and local dev. There is no
# fallback to the live key outside production — a missing test key skips
# invoicing rather than charging live. Without any key, quoted signings still
# record and the notification email says the invoice must be sent manually.
# ACH Direct Debit must be enabled on the Stripe account for the card+ACH
# invoice; if it isn't, the route falls back to card-only automatically.
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=

# Stripe webhook signing secret (whsec_…) for /api/webhooks/stripe.
# Live endpoint secret when VERCEL_ENV=production. Previews/dev use
# STRIPE_TEST_WEBHOOK_SECRET, then fall back to this value (so `stripe listen`
# can store its CLI secret in STRIPE_WEBHOOK_SECRET locally).
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI Systems — Speed-to-Lead demo only (/ai-systems). Isolated from the
# production contact form. Apply supabase/migrations/20260817233000_demo_leads.sql
# before submitting the demo form. Secrets stay in .env.local / Vercel / n8n env.
# ---------------------------------------------------------------------------

# n8n production webhook, e.g. http://localhost:5678/webhook/speed-to-lead
# (activate the imported workflow; the test URL is webhook-test/…).
N8N_WEBHOOK_URL=

# Shared secret: Next.js ↔ n8n PATCH/GET of demo leads, and optional Vapi fallback.
DEMO_LEADS_WEBHOOK_SECRET=

# Password gate for /ai-systems/dashboard. DEMO_DASHBOARD_SECRET is the cookie
# HMAC key; if omitted, the password is used as the key.
DEMO_DASHBOARD_PASSWORD=
DEMO_DASHBOARD_SECRET=

# Vapi signs POST /api/ai-systems/vapi with this value (x-vapi-secret).
# Must match the VAPI_SERVER_SECRET you set in the n8n environment.
VAPI_SERVER_SECRET=

# Public Cal.com event URL used in the SMS fallback (also set in n8n).
CAL_COM_BOOKING_URL=

# Optional — book a slot from the Vapi end-of-call report when the assistant
# collected a time + email. Event type id is numeric.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# n8n environment (set on the n8n host, not in the Next.js client bundle):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_VOICE_ID=Savannah
# VAPI_SERVER_SECRET=   (same value as above)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# CAL_COM_BOOKING_URL=
# DEMO_LEADS_WEBHOOK_SECRET=   (same value as above)
