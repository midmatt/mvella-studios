# Contact form / quote builder email (spec §5). Copy to .env.local and fill in.

# Required for /api/contact to send anything — without it the route answers
# 503 and both forms fall back to showing the direct email address.
RESEND_API_KEY=

# Where notifications land. Defaults to matthew@mvella.com.
CONTACT_TO_EMAIL=

# Verified sender on mvella.com. Defaults to "MVella Studios <hello@mvella.com>".
# Must be a domain verified in Resend — gmail.com (and any other domain you
# don't own) is rejected as a From address.
CONTACT_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=

# Google Ads conversion label (the part AFTER the slash in send_to).
# From Google Ads → Goals → Conversions → your action → Tag setup.
# Example send_to "AW-18376948373/AbCdEfGhIjKlMnOp" → set AbCdEfGhIjKlMnOp.
# Without this, the base gtag still loads but conversion events are skipped.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Supabase — /agreement signing flow (project: mvella-studios / cwqbjbpjtdhhmfofsgvo).
# SECRET key, server-only: the agreements table has RLS on with no policies,
# so the API route is the only thing that can write (or read) it. Never
# expose this key client-side. Without both vars the route answers 503 and
# the signing form errors — it never fakes a recorded consent.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe — deposit invoicing when an agreement is signed via a quote link.
# STRIPE_SECRET_KEY is the LIVE key: used only on the production deployment.
# STRIPE_TEST_SECRET_KEY is used on previews and local dev. There is no
# fallback to the live key outside production — a missing test key skips
# invoicing rather than charging live. Without any key, quoted signings still
# record and the notification email says the invoice must be sent manually.
# ACH Direct Debit must be enabled on the Stripe account for the card+ACH
# invoice; if it isn't, the route falls back to card-only automatically.
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
